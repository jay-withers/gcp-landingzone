# Local .terraform directories
**/.terraform/*

# .tfstate files. Every component keeps state in the gcs backend except
# bootstrap, which creates that bucket and so keeps its own locally - see
# terraform/bootstrap/README.md. Never commit it; it is recoverable by import,
# not by git.
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# *.tfvars files are committed intentionally (each component's terraform.tfvars
# holds its non-sensitive inputs). Do not put secrets in them. gitleaks
# (pre-commit and CI) scans every commit as a backstop.

# CLI configuration and override files
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Provider lock files ARE committed, unlike in template-repo-terraform-root:
# every directory here is a root config, so the locks are ours to pin, with
# hashes for linux_amd64, linux_arm64 and darwin_arm64.

# Saved plan output
*.tfplan

# macOS finder metadata
.DS_Store
**/.DS_Store
